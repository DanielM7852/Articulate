FROM node:24-slim AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web /app/web
COPY vowel-mapper/src /app/vowel-mapper/src
COPY mouth-demo /app/mouth-demo
RUN npm run build

FROM nginx:1.28-alpine
COPY deploy/nginx.practice.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
