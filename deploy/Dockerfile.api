FROM ghcr.io/astral-sh/uv:0.9.6 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra moss
COPY services services
COPY content content
RUN mkdir -p /app/.data && useradd --system --uid 10001 articulate && chown -R articulate /app/.data
USER articulate
EXPOSE 8000
CMD [".venv/bin/uvicorn","app.main:app","--app-dir","services/api","--host","0.0.0.0","--port","8000","--ws-max-size","65536","--ws-max-queue","8","--no-access-log"]
