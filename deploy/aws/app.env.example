# Copy to deploy/aws/app.env on the server (never commit app.env) and fill in the blanks.
# Also put SITE_DOMAIN=demo.example.com in deploy/aws/.env (read by compose for Caddy and the cert).

# --- Live coach (OpenAI is the live provider) -------------------------------------------------
LIVE_COACH_PROVIDER=openai
OPENAI_API_KEY=
# Optional: only if you switch LIVE_COACH_PROVIDER=anthropic or want the Claude recap.
ANTHROPIC_API_KEY=

# --- SpacetimeDB (classroom + telemetry) ------------------------------------------------------
SPACETIME_URI=https://maincloud.spacetimedb.com
SPACETIME_DATABASE=articulate-live
SPACETIME_TOKEN=

# --- Optional integrations --------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
RESEND_API_KEY=
RECAP_EMAIL_FROM=
# Voice: no CARTESIA_* on purpose, so the app uses its browser-voice fallback.

# --- Phone model and SPARC: OFF for now -------------------------------------------------------
# Blank = "Phone model offline" basic view. Milestone 2: set to the GPU box's private IP, e.g.
# PHONES_URL=http://10.0.1.23:8020  and  ARTICULATION_URL=http://10.0.1.23:8010
PHONES_URL=
ARTICULATION_URL=

# --- Hosting ----------------------------------------------------------------------------------
# Browser origins allowed by CORS and by the /phones/ws origin check. Same-origin pages need no entry
# (the origin check also accepts Origin host == Host), but listing the site is harmless.
CORS_ORIGINS=https://demo.example.com
# Secure cookies are right behind HTTPS (Caddy). Default is true; kept explicit.
LIVE_COOKIE_SECURE=true
# Never true on a public box: it would expose unauthenticated /v1/dev/classroom/* routes.
CLASSROOM_DEV_IDENTITIES=false
# STATIC_DIR, STORE_DIR, HOST and PORT are set in the image; do not override.

# --- Rate limits for the public demo ----------------------------------------------------------
# Implemented by the rate-limit change (not on main yet); unknown vars are ignored until it lands.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_REALTIME_PER_IP_HOUR=6
RATE_LIMIT_REALTIME_GLOBAL_HOUR=60
RATE_LIMIT_COACH_PER_IP_HOUR=240
RATE_LIMIT_COACH_GLOBAL_HOUR=2400
RATE_LIMIT_PHONES_WS_PER_IP=2
RATE_LIMIT_PHONES_WS_GLOBAL=4
