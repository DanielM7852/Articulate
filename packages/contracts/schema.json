{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contracts",
  "type": "object",
  "properties": {
    "Target": {
      "$ref": "#/definitions/Target"
    },
    "Session": {
      "$ref": "#/definitions/Session"
    },
    "FeatureFrame": {
      "$ref": "#/definitions/FeatureFrame"
    },
    "AttemptSummary": {
      "$ref": "#/definitions/AttemptSummary"
    },
    "Cue": {
      "$ref": "#/definitions/Cue"
    },
    "CoachingDecision": {
      "$ref": "#/definitions/CoachingDecision"
    },
    "CoachingProposal": {
      "$ref": "#/definitions/CoachingProposal"
    },
    "CoachingRequest": {
      "$ref": "#/definitions/CoachingRequest"
    },
    "CoachingContext": {
      "$ref": "#/definitions/CoachingContext"
    },
    "CoachingPolicy": {
      "$ref": "#/definitions/CoachingPolicy"
    },
    "CoachingPlan": {
      "$ref": "#/definitions/CoachingPlan"
    },
    "CueOutcome": {
      "$ref": "#/definitions/CueOutcome"
    },
    "EvidenceReference": {
      "$ref": "#/definitions/EvidenceReference"
    },
    "SupportedObservation": {
      "$ref": "#/definitions/SupportedObservation"
    },
    "ActionOption": {
      "$ref": "#/definitions/ActionOption"
    },
    "AudioManifest": {
      "$ref": "#/definitions/AudioManifest"
    },
    "Event": {
      "$ref": "#/definitions/Event"
    },
    "Command": {
      "$ref": "#/definitions/Command"
    },
    "PoseId": {
      "$ref": "#/definitions/PoseId"
    },
    "TargetId": {
      "$ref": "#/definitions/TargetId"
    },
    "Action": {
      "$ref": "#/definitions/Action"
    },
    "State": {
      "$ref": "#/definitions/State"
    },
    "ObservationId": {
      "$ref": "#/definitions/ObservationId"
    }
  },
  "required": [
    "Target",
    "Session",
    "FeatureFrame",
    "AttemptSummary",
    "Cue",
    "CoachingDecision",
    "CoachingProposal",
    "CoachingRequest",
    "CoachingContext",
    "CoachingPolicy",
    "CoachingPlan",
    "CueOutcome",
    "EvidenceReference",
    "SupportedObservation",
    "ActionOption",
    "AudioManifest",
    "Event",
    "Command",
    "PoseId",
    "TargetId",
    "Action",
    "State",
    "ObservationId"
  ],
  "additionalProperties": false,
  "definitions": {
    "Target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "i",
            "u",
            "aa"
          ],
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "f1": {
          "title": "F1",
          "type": "number"
        },
        "f2": {
          "title": "F2",
          "type": "number"
        },
        "radius_f1": {
          "default": 160,
          "title": "Radius F1",
          "type": "number"
        },
        "radius_f2": {
          "default": 350,
          "title": "Radius F2",
          "type": "number"
        },
        "pose_id": {
          "enum": [
            "vowel-i",
            "vowel-u",
            "vowel-aa",
            "neutral"
          ],
          "title": "Pose Id",
          "type": "string"
        },
        "provenance": {
          "default": "Engineering demonstration region; not a personalized pronunciation standard.",
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "label",
        "f1",
        "f2",
        "radius_f1",
        "radius_f2",
        "pose_id",
        "provenance"
      ],
      "title": "Target",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "format": "uuid",
          "title": "Owner",
          "type": "string"
        },
        "target_id": {
          "default": "i",
          "enum": [
            "i",
            "u",
            "aa"
          ],
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "const": 1,
          "default": 1,
          "title": "Target Version",
          "type": "integer"
        },
        "language": {
          "const": "en",
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "audio_enabled": {
          "default": false,
          "title": "Audio Enabled",
          "type": "boolean"
        },
        "assistance_level": {
          "default": "guided",
          "enum": [
            "guided",
            "reduced"
          ],
          "title": "Assistance Level",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "default": "ready",
          "enum": [
            "ready",
            "capturing",
            "analyzing",
            "coaching",
            "presenting",
            "paused"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "owner",
        "target_id",
        "target_version",
        "language",
        "audio_enabled",
        "assistance_level",
        "revision",
        "state"
      ],
      "title": "Session",
      "type": "object"
    },
    "FeatureFrame": {
      "additionalProperties": false,
      "properties": {
        "sample_offset": {
          "minimum": 0,
          "title": "Sample Offset",
          "type": "integer"
        },
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "number"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Duration Ms",
          "type": "number"
        },
        "f1": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F1"
        },
        "f2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 5000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F2"
        },
        "f0": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F0"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Quality Flags",
          "type": "array"
        },
        "source": {
          "enum": [
            "microphone",
            "synthetic"
          ],
          "title": "Source",
          "type": "string"
        },
        "lip_opening": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lip Opening"
        }
      },
      "required": [
        "sample_offset",
        "timestamp_ms",
        "duration_ms",
        "f1",
        "f2",
        "f0",
        "valid",
        "quality_flags",
        "source",
        "lip_opening"
      ],
      "title": "FeatureFrame",
      "type": "object"
    },
    "AttemptSummary": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "target_id": {
          "enum": [
            "i",
            "u",
            "aa"
          ],
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "const": 1,
          "default": 1,
          "title": "Target Version",
          "type": "integer"
        },
        "capture_start_sample": {
          "minimum": 0,
          "title": "Capture Start Sample",
          "type": "integer"
        },
        "capture_end_sample": {
          "minimum": 0,
          "title": "Capture End Sample",
          "type": "integer"
        },
        "sample_rate": {
          "maximum": 96000,
          "minimum": 8000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "usable_duration_ms": {
          "minimum": 0,
          "title": "Usable Duration Ms",
          "type": "number"
        },
        "usable_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Usable Fraction",
          "type": "number"
        },
        "f1_mean": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F1 Mean"
        },
        "f2_mean": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 5000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F2 Mean"
        },
        "target_distance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Distance"
        },
        "lip_opening_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lip Opening Mean"
        },
        "quality_flags": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Quality Flags",
          "type": "array"
        },
        "evidence_fields": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence Fields",
          "type": "array"
        },
        "source": {
          "enum": [
            "microphone",
            "synthetic"
          ],
          "title": "Source",
          "type": "string"
        },
        "assistance_level": {
          "default": "guided",
          "enum": [
            "guided",
            "reduced"
          ],
          "title": "Assistance Level",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "target_id",
        "target_version",
        "capture_start_sample",
        "capture_end_sample",
        "sample_rate",
        "usable_duration_ms",
        "usable_fraction",
        "f1_mean",
        "f2_mean",
        "target_distance",
        "lip_opening_mean",
        "quality_flags",
        "evidence_fields",
        "source",
        "assistance_level"
      ],
      "title": "AttemptSummary",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "corpus_revision": {
          "const": 2,
          "default": 2,
          "title": "Corpus Revision",
          "type": "integer"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "enum": [
              "i",
              "u",
              "aa"
            ],
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "language": {
          "const": "en",
          "title": "Language",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "simple",
            "standard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "applicability": {
          "const": "usable_capture",
          "title": "Applicability",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "approved",
            "demo_unreviewed",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "pose_id": {
          "enum": [
            "vowel-i",
            "vowel-u",
            "vowel-aa",
            "neutral"
          ],
          "title": "Pose Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "corpus_revision",
        "text",
        "target_ids",
        "language",
        "difficulty",
        "applicability",
        "source_url",
        "review_status",
        "pose_id"
      ],
      "title": "Cue",
      "type": "object"
    },
    "CoachingPolicy": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "demo-v1",
          "default": "demo-v1",
          "title": "Version",
          "type": "string"
        },
        "min_usable_duration_ms": {
          "default": 300,
          "maximum": 5000,
          "minimum": 100,
          "title": "Min Usable Duration Ms",
          "type": "number"
        },
        "min_usable_fraction": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Usable Fraction",
          "type": "number"
        },
        "region_distance": {
          "const": 1,
          "default": 1,
          "title": "Region Distance",
          "type": "integer"
        },
        "distance_change_threshold": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Distance Change Threshold",
          "type": "number"
        },
        "successful_attempts_to_reduce": {
          "default": 3,
          "maximum": 6,
          "minimum": 2,
          "title": "Successful Attempts To Reduce",
          "type": "integer"
        },
        "unsuccessful_retries_to_change": {
          "default": 2,
          "maximum": 5,
          "minimum": 2,
          "title": "Unsuccessful Retries To Change",
          "type": "integer"
        },
        "history_limit": {
          "default": 8,
          "maximum": 12,
          "minimum": 6,
          "title": "History Limit",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "min_usable_duration_ms",
        "min_usable_fraction",
        "region_distance",
        "distance_change_threshold",
        "successful_attempts_to_reduce",
        "unsuccessful_retries_to_change",
        "history_limit"
      ],
      "title": "CoachingPolicy",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "usable_duration_ms",
            "usable_fraction",
            "target_distance",
            "f1_mean",
            "f2_mean"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "attempt_id",
        "field",
        "value"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "CoachingDecision": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "observation": {
          "maxLength": 250,
          "title": "Observation",
          "type": "string"
        },
        "evidence_fields": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Fields",
          "type": "array"
        },
        "cue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cue Id"
        },
        "cue_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cue Version"
        },
        "pose_id": {
          "enum": [
            "vowel-i",
            "vowel-u",
            "vowel-aa",
            "neutral"
          ],
          "title": "Pose Id",
          "type": "string"
        },
        "next_action": {
          "enum": [
            "repeat",
            "change_cue",
            "simplify",
            "reduce_assistance",
            "next_target",
            "pause",
            "repair_capture"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration"
        },
        "observation_id": {
          "anyOf": [
            {
              "enum": [
                "capture.insufficient",
                "capture.unavailable",
                "capture.usable",
                "target.inside",
                "target.outside",
                "trend.closer",
                "trend.similar",
                "trend.farther",
                "progress.ready_to_reduce"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "evidence": {
          "items": {
            "$ref": "#/definitions/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "policy_version": {
          "const": "demo-v1",
          "default": "demo-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "selection_source": {
          "default": "fallback",
          "enum": [
            "mock",
            "claude",
            "fallback"
          ],
          "title": "Selection Source",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/definitions/CoachingPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "attempt_id",
        "generation_id",
        "observation",
        "evidence_fields",
        "cue_id",
        "cue_version",
        "pose_id",
        "next_action",
        "narration",
        "observation_id",
        "evidence",
        "rationale",
        "policy_version",
        "selection_source",
        "policy"
      ],
      "title": "CoachingDecision",
      "type": "object"
    },
    "CoachingProposal": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "observation_id": {
          "enum": [
            "capture.insufficient",
            "capture.unavailable",
            "capture.usable",
            "target.inside",
            "target.outside",
            "trend.closer",
            "trend.similar",
            "trend.farther",
            "progress.ready_to_reduce"
          ],
          "title": "Observation Id",
          "type": "string"
        },
        "cue_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cue Id"
        },
        "cue_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cue Version"
        },
        "next_action": {
          "enum": [
            "repeat",
            "change_cue",
            "simplify",
            "reduce_assistance",
            "next_target",
            "pause",
            "repair_capture"
          ],
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "generation_id",
        "observation_id",
        "cue_id",
        "cue_version",
        "next_action"
      ],
      "title": "CoachingProposal",
      "type": "object"
    },
    "CoachingContext": {
      "additionalProperties": false,
      "properties": {
        "attempt_history": {
          "items": {
            "$ref": "#/definitions/AttemptSummary"
          },
          "maxItems": 12,
          "title": "Attempt History",
          "type": "array"
        },
        "cue_history": {
          "items": {
            "$ref": "#/definitions/CueOutcome"
          },
          "maxItems": 12,
          "title": "Cue History",
          "type": "array"
        },
        "policy": {
          "$ref": "#/definitions/CoachingPolicy"
        }
      },
      "required": [
        "attempt_history",
        "cue_history",
        "policy"
      ],
      "title": "CoachingContext",
      "type": "object"
    },
    "CueOutcome": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cue Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "target_id": {
          "enum": [
            "i",
            "u",
            "aa"
          ],
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "const": 1,
          "default": 1,
          "title": "Target Version",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "microphone",
                "synthetic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "distance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance"
        },
        "result": {
          "enum": [
            "awaiting_retry",
            "improved",
            "no_improvement",
            "region_match",
            "inconclusive"
          ],
          "title": "Result",
          "type": "string"
        },
