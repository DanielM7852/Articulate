              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Deg"
        },
        "yaw_deg": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw Deg"
        },
        "roll_deg": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
