          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "f1": {
          "title": "F1",
          "type": "number"
        },
        "f2": {
          "title": "F2",
          "type": "number"
        },
        "radius_f1": {
          "default": 160,
