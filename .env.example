# All provider credentials remain on the Python server. Mock mode makes no provider calls.
MOCK_MODE=true
ALLOW_DEMO_CUES=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATA_DIR=.data
SESSION_TTL_SECONDS=3600
PROVIDER_DEADLINE_SECONDS=12
PLAYBACK_BUFFER_MS=80
FORMANT_CEILING=5500
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=articulate-cues-v2
# Engineering task thresholds; not clinical scores. Omit to use the defaults.
COACHING_POLICY={"min_usable_duration_ms":300,"min_usable_fraction":0.3,"distance_change_threshold":0.1,"successful_attempts_to_reduce":3,"unsuccessful_retries_to_change":2}
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_VOICE=
CARTESIA_VERSION=2025-04-16
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DATABASE=
# Must be a token belonging to the identity that published the module.
SPACETIMEDB_TOKEN=
