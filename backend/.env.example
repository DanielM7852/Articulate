# Tunable settings. API keys and tokens live in .env.secrets (see .env.secrets.example), not here.
# Server-side only. Do not commit a filled-in .env or expose these to the browser.

# Anthropic structured coaching. Leave blank to use the disclosed deterministic fallback.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Moss cue retrieval. Both values are required before the Moss adapter is used.
# Install the optional package with: pip install -e ".[moss]"
MOSS_PROJECT_ID=
MOSS_INDEX_NAME=articulate-cues

# Cartesia speaks the prepared reference when the key is set. The coaching line is still only a handoff.
# Leave the voice blank to use the documented Skylar id.
CARTESIA_VOICE_ID=
CARTESIA_VERSION=2026-08-14
CARTESIA_MODEL_ID=sonic-3.6

STORE_DIR=.local_store

OVERALL_TIMEOUT_S=45
REASONING_TIMEOUT_S=12
AUDIO_TIMEOUT_S=30
MAX_PROVIDER_RETRIES=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Live coaching. SpacetimeDB (Maincloud) holds streamed metrics and learner history; leave database and
# token (in .env.secrets) blank to use request-body frames and local JSON history under .local_store/learners/.
# The token is server-side only and is never logged or returned.
SPACETIME_URI=https://maincloud.spacetimedb.com
SPACETIME_DATABASE=
# Per-attempt coach model and thinking ("on" = adaptive default, "off" = disabled; off needs effort low/medium/high).
# Models: claude-sonnet-5-5, claude-haiku-5-5. Effort: low, medium, high.
LIVE_COACH_MODEL=claude-sonnet-5-5
LIVE_COACH_THINKING=on
LIVE_NOTES_MODEL=claude-sonnet-5-5
LIVE_COACH_EFFORT=medium
LIVE_NOTES_EFFORT=high
LIVE_COACH_TIMEOUT_S=15
LIVE_HISTORY_LIMIT=12
# Background articulation analysis via the local collector (services/articulation). Blank = off.
# ARTICULATION_URL=http://127.0.0.1:8010
# ARTICULATION_TIMEOUT_S=30
# ARTICULATION_MODELS=sparc,silero_vad
# ARTICULATION_MAX_QUEUE=2
# Therapist-led conversation sessions (/v1/live/session/*): effort for each model turn, therapist name, idle TTL.
LIVE_TALK_EFFORT=medium
LIVE_THERAPIST_NAME=Ava
LIVE_SESSION_TTL_S=3600
# Insight lane: a deeper model writes one tongue-comparison line after SPARC analysis (validated, template fallback).
LIVE_INSIGHT_MODEL=claude-opus-5-5
LIVE_INSIGHT_EFFORT=high
LIVE_INSIGHT_TIMEOUT_S=45
INSIGHT_TTL_S=900

# Shared practice API + standalone workers. Publish the updated module before enabling.
# Local mode preserves the current synchronous demo behavior.
LIVE_COORDINATION=local
LIVE_COOKIE_SECURE=true
LIVE_WORKER_CONCURRENCY=4
# Shared cap across all workers connected to this database; tune to provider quotas.
LIVE_GLOBAL_CONCURRENCY=32
LIVE_QUEUE_LIMIT=1000
LIVE_JOBS_PER_PROFILE=4
LIVE_JOB_LEASE_S=60
LIVE_JOB_POLL_S=0.2
LIVE_JOB_RETENTION_S=3600
