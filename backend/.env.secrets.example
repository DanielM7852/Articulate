# Secrets for the backend. This file is gitignored and server-side only: never commit it or expose it to the browser.

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# OpenAI API key (platform.openai.com): Ava's realtime session and, by default, the live coach.
OPENAI_API_KEY=
# Cartesia API key (play.cartesia.ai).
CARTESIA_API_KEY=
# SpacetimeDB owner/backend token (run `spacetime login show --token`).
SPACETIME_TOKEN=
# Moss project key (Moss dashboard, next to the project id).
MOSS_PROJECT_KEY=
# Random signing secret of at least 32 characters; identical on all shared API/worker replicas.
# Generate locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
LIVE_IDENTITY_SECRET=
