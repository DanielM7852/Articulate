VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DATABASE=articulate-live

# Backend dashboard telemetry (docs/telemetry.md). Set to "off" to disable the browser client.
VITE_TELEMETRY=

# Classroom every learner joins silently as a virtual learner (docs/teacher-dashboard.md). [a-z0-9-], at most 24
# characters; empty or invalid falls back to room-1.
VITE_CLASSROOM_DEFAULT=room-1
